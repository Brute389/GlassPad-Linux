[Desktop Entry]
Type=Application
Version=1.0
Name=GlassPad
GenericName=Touch gamepad overlay
Comment=Turn the touchscreen into a virtual Xbox gamepad
# No %u/%f field codes: glasspad's parser accepts no file or URL arguments, so
# any token a launcher appends would be an unrecognized argument (exit 2).
Exec=@PYTHON@ -m glasspad
Path=@PACKAGE_DIR@
Icon=glasspad
Terminal=false
# One main category only: "Game;Utility;" is legal but desktop-file-validate
# warns the app may then appear twice in the menu, and the second entry is pure
# clutter. Discoverability comes from Keywords instead.
Categories=Game;
Keywords=gamepad;controller;touch;xbox;overlay;
StartupNotify=false
X-KDE-StartupNotify=false
# The overlay is a full-screen click-through surface; a second instance would
# double every input, so the session manager must not restore duplicates.
X-GNOME-SingleWindow=true
Actions=status;

[Desktop Action status]
Name=Check GlassPad environment
Exec=@PYTHON@ -m glasspad --status
